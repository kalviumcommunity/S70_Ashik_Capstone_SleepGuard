PORT=5000
# In production, use your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sleepguard?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_for_production
# Optional: real SMTP email credentials for live OTP emails (defaults to Ethereal mock inbox if omitted)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
